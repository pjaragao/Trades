# ---- Copiloto de Trades (Docker) ----
# Senha de acesso à interface (OBRIGATÓRIA se o app ficar acessível na rede)
COPILOTO_PASSWORD=troque-esta-senha
# Chave para assinar a sessão (opcional; se vazia, é gerada e salva em /data/.secret_key)
SECRET_KEY=
# Atrás de proxy reverso com HTTPS (Traefik, Nginx Proxy Manager, Caddy...)
TRUST_PROXY=false
COOKIE_SECURE=false

# ---- TradingFloors (obrigatório) ----
TF_EMAIL=seu_email@exemplo.com
TF_PASSWORD=sua_senha

# ---- Alertas no Telegram (opcional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Fase 6: execução de ordens ----
# Trava da execução REAL. Deixe false até testar bastante no modo Simulação.
EXECUTION_ENABLED=false
# mt5_remote: o container fala com o agente MT5 que roda no Windows ao lado do terminal
EXECUTION_BROKER=mt5_remote
MT5_AGENT_URL=http://192.168.0.10:8765
# Mesmo token configurado no agente (mínimo 16 caracteres). Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
MT5_AGENT_TOKEN=

LOG_LEVEL=INFO
