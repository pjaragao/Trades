# ---- Copiloto de Trades (Docker / Coolify) ----
# Senha de acesso à interface (OBRIGATÓRIA)
COPILOTO_PASSWORD=troque-esta-senha
# Chave para assinar a sessão (opcional; se vazia, é gerada e salva em /data/.secret_key)
SECRET_KEY=
# Atrás de proxy reverso com HTTPS: TRUST_PROXY=1 (um proxy, ex.: só o Coolify/Traefik)
# ou TRUST_PROXY=2 (nginx na frente do Coolify). COOKIE_SECURE=true quando o acesso for por https.
TRUST_PROXY=false
COOKIE_SECURE=false
# Porta publicada no host (no Coolify o proxy dele acessa direto a porta 5000 do container)
COPILOTO_PORT=5000

# ---- TradingFloors (obrigatório) ----
TF_EMAIL=seu_email@exemplo.com
TF_PASSWORD=sua_senha

# ---- Alertas no Telegram (opcional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Cotações ----
# auto: usa o MT5 (se o agente estiver configurado) e a brapi (se houver token). Opções: auto | mt5 | brapi | off
QUOTES_PROVIDER=auto
# brapi.dev (token grátis): cotação de AÇÕES com atraso de até 30 min. Opções ficam com o TradingFloors.
# Plano gratuito: 1 ativo por requisição e 15.000 requisições em 30 dias -> o Copiloto usa no máximo 450/dia.
BRAPI_TOKEN=
BRAPI_DAILY_BUDGET=450
# MT5 em tempo real: intervalo entre consultas no pregão (segundos)
QUOTES_INTERVAL=2

# ---- MT5 (agente no Windows) e execução de ordens ----
# O agente roda no Windows ao lado do terminal MT5 (no homelab com WSL: o próprio Windows que hospeda o WSL).
# Só cotações:  start_mt5_agent.bat --readonly
MT5_AGENT_URL=
# Mesmo token configurado no agente (mínimo 16 caracteres). Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
MT5_AGENT_TOKEN=
EXECUTION_BROKER=mt5_remote
# Trava da execução REAL. Deixe false até testar bastante no modo Simulação.
EXECUTION_ENABLED=false

LOG_LEVEL=INFO
