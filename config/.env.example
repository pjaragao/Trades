# Credenciais da plataforma TradingFloors (obrigatório)
TF_EMAIL=seu_email@exemplo.com
TF_PASSWORD=sua_senha

# Alertas no celular via Telegram (opcional)
# 1) fale com o @BotFather e crie um bot -> token
# 2) mande qualquer mensagem para o seu bot e abra
#    https://api.telegram.org/bot<TOKEN>/getUpdates para ver o chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Fase 6: execução de ordens ----
# Trava da execução REAL (também pode ser execution.enabled no settings.yaml)
EXECUTION_ENABLED=false
# mt5_local: Copiloto rodando no próprio Windows com o MT5 | mt5_remote: Copiloto no Docker falando com o agente
EXECUTION_BROKER=mt5_local
# Agente MT5 (start_mt5_agent.bat): token compartilhado com o Copiloto no Docker (mínimo 16 caracteres)
MT5_AGENT_TOKEN=
MT5_AGENT_URL=
# Opcional: caminho do terminal64.exe se houver mais de um MT5 instalado
MT5_TERMINAL_PATH=

# Login no app (deixe vazio para uso só local em 127.0.0.1)
COPILOTO_PASSWORD=
